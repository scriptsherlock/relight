{
  "name": "relight",
  "version": "0.1.0",
  "private": true,
  "description": "Relight (working title): a level-based coding game where pupils program a robot in Python or blocks, then build and share their own levels and games.",
  "type": "module",
  "scripts": {
    "sync:pyodide": "node tools/sync-pyodide.mjs",
    "predev": "node tools/sync-pyodide.mjs",
    "dev": "vite --host 127.0.0.1",
    "prebuild": "node tools/sync-pyodide.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4180 --strictPort",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "blockly": "^13.4.0",
    "codemirror": "^6.0.2",
    "pyodide": "^314.0.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.8",
    "vitest": "^4.1.12"
  }
}
